# Copy to .env. Never commit .env or real keys.

# Relayer (runtime)
RELAYER_ACCOUNT_ID=relayer.testnet
RELAYER_PRIVATE_KEY=ed25519:replace-me
APP_PARENT_ACCOUNT=app.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR sent to each new account
FUND_AMOUNT=0.1
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
# Marketplace database (Supabase). The service-role key stays on the relayer only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Deal contract the relayer reads to verify listing slots
CONTRACT_ID=blind-deal-59xtyh4b.testnet
# Should: NEAR AI proxy (S-02)
NEAR_AI_API_KEY=

# App (build time)
# Leave VITE_CONTRACT_ID empty to run the app on the shared dev-server mock chain (npm run dev -w app);
# chainFor() in app/src/client.ts then hands screens a mock Signer and the mock TEE key.
VITE_CONTRACT_ID=blind-deal-59xtyh4b.testnet
VITE_RELAYER_URL=http://localhost:8787
VITE_TEE_PUBKEY=
# Supabase Auth for Google/email sign-in: the project URL and the publishable (anon) key, never the service-role key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
